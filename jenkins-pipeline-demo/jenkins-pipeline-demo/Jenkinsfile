pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('jenkins-pipeline-demo/jenkins-pipeline-demo') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('jenkins-pipeline-demo/jenkins-pipeline-demo') {
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('jenkins-pipeline-demo/jenkins-pipeline-demo') {
                    sh 'mvn package'
                }
            }
        }
    }
}

pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('jenkins-pipeline-demo/jenkins-pipeline-demo') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('jenkins-pipeline-demo/jenkins-pipeline-demo') {
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('jenkins-pipeline-demo/jenkins-pipeline-demo') {
                    sh 'mvn package'
                }
            }
        }
    }

    post {
        success {
            emailext(
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "The Jenkins pipeline completed successfully.",
                to: "imandijahnavi.23.cse@anits.edu.in"
            )
        }

        failure {
            emailext(
                subject: "FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "The Jenkins pipeline failed. Please check the console output.",
                to: "imandijahnavi.23.cse@anits.edu.in"
            )
        }
    }
}
